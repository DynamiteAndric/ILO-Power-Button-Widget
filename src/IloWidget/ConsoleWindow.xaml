<Window x:Class="IloWidget.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="iLO Remote Console" Width="1100" Height="760" MinWidth="520" MinHeight="380"
        Background="#061018" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!-- Opaque window with custom chrome: WebView2 cannot render inside a transparent (layered) window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- a maximized chrome-less window overhangs the screen by the resize border -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.Row="0" Background="#0A1C2B">
                <Path Data="M 0,34 L 0,12 L 12,0 L 70,0" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" IsHitTestVisible="False" />
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,4,0">
                        <Button Style="{StaticResource HudIconButton}" Content="&#xE72C;" ToolTip="Reconnect" Click="Reconnect_Click" Width="34" Height="30" FontSize="13" />
                        <Button Style="{StaticResource HudIconButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" Width="34" Height="30" FontSize="11" />
                        <Button Style="{StaticResource HudIconButton}" Content="&#xE922;" ToolTip="Maximize / restore" Click="Maximize_Click" Width="34" Height="30" FontSize="11" />
                        <Button Style="{StaticResource HudIconButton}" Content="&#xE8BB;" ToolTip="Close and log out" Click="Close_Click" Width="34" Height="30" FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource HudLabel}" FontSize="12" VerticalAlignment="Center" Margin="22,0,0,0" Text="UNSC // REMOTE CONSOLE" />
                </DockPanel>
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource AccentBrush}" Opacity="0.6" />
            </Grid>

            <!-- console. WPF content cannot be drawn over WebView2, so the overlay and the browser are shown alternately. -->
            <wv2:WebView2 x:Name="Web" Grid.Row="1" Visibility="Collapsed" DefaultBackgroundColor="#061018" />

            <StackPanel x:Name="Overlay" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                <TextBlock x:Name="OverlayLabel" FontFamily="{StaticResource HudFont}" FontSize="34" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Text="LINKING" />
                <TextBlock x:Name="OverlayDetail" Style="{StaticResource HudLabel}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,6,0,0" Text="OPENING REMOTE CONSOLE SESSION" />
                <Button x:Name="RetryButton" Style="{StaticResource HudButton}" Content="RETRY" Width="120" Margin="0,22,0,0"
                        Visibility="Collapsed" Click="Reconnect_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
